---
layout: null
permalink: /courses/feed.xml
sitemap: false
---
{%- assign items = site.courses | sort: "date" | reverse -%}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ site.lang }}">
  <title type="text">{{ site.title }} — دوره‌ها</title>
  <subtitle type="text">دوره‌های آموزش سنگ‌نوردی</subtitle>
  <id>{{ '/courses/feed.xml' | absolute_url }}</id>
  <link href="{{ '/courses/feed.xml' | absolute_url }}" rel="self" type="application/atom+xml"/>
  <link href="{{ '/courses/' | absolute_url }}" rel="alternate" type="text/html"/>
  <updated>{{ items.first.date | default: site.time | date_to_xmlschema }}</updated>
  <author><name>{{ site.author.name | xml_escape }}</name><uri>{{ site.author.url }}</uri></author>
{% include atom-entries.html items=items %}
</feed>
